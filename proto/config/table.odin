package config

// The option table. One row per upstream option, plus noirvpn extensions.
// Rows are sorted by name (byte order). A test checks this, and checks that
// every option heading of the upstream man pages has a row.

//odinfmt: disable
@(rodata)
OPTIONS := [?]Option {
	{"allow-compression", .Supported, .Both, 1, 1, {}, "protocol", "only the value no is accepted because compression has been removed"},
	{"allow-deprecated-insecure-static-crypto", .Rejected, .Both, 0, 0, {}, "protocol", "static-key mode has been removed; use TLS"},
	{"allow-nonadmin", .Rejected, .Both, 0, 1, {}, "windows", "the service decides who may connect (bus-allow sid)"},
	{"allow-pull-fqdn", .Ignored, .Client, 0, 0, {}, "client", "pushed host names are not resolved; push IP addresses"},
	{"allow-recursive-routing", .Ignored, .Client, 0, 0, {}, "client", "no effect"},
	{"app-custom-control", .Rejected, .Both, 1, 1, {}, "management", "custom control messages are not supported"},
	{"askpass", .Supported, .Both, 0, 1, {}, "tls", "the passphrase of an encrypted key (key, tls-transport-key): the first line of the file, or typed at the terminal at start-up when no file is given"},
	{"auth", .Supported, .Both, 1, 1, {}, "protocol", "digest for tls-auth; the data channel only uses AEAD"},
	{"auth-external", .New, .Server, 0, 1, {}, "noirvpn", "ask a bus controller to decide each session; optional timeout in seconds"},
	{"auth-gen-token", .Rejected, .Server, 0, 3, {}, "server", "auth tokens are not issued; a controller decides each login on the control bus (auth-external)"},
	{"auth-gen-token-secret", .Rejected, .Server, 0, 1, {.Inline}, "server", "auth tokens are issued from external authentication on the control bus (auth-external)"},
	{"auth-nocache", .Ignored, .Client, 0, 0, {}, "generic", "no effect"},
	{"auth-retry", .Supported, .Client, 1, 1, {}, "client", "none, nointeract or interact"},
	{"auth-token", .Supported, .Client, 1, 1, {.Pushable, .Push_Only}, "client", "pushed by the server after authentication"},
	{"auth-token-user", .Supported, .Client, 1, 1, {.Pushable, .Push_Only}, "client", "pushed by the server with auth-token"},
	{"auth-user-pass", .Supported, .Client, 0, 1, {.Inline}, "client", "send a username and password; the file contains them on two lines"},
	{"auth-user-pass-optional", .Rejected, .Server, 0, 0, {}, "server", "username checks are handled over the control bus (auth-external)"},
	{"auth-user-pass-verify", .Rejected, .Server, 1, 2, {}, "script", "scripts have been removed; use auth-external to decide over the control bus (auth.decide)"},
	{"auth-web", .New, .Server, 0, 0, {}, "noirvpn", "a client that sends IV_SSO=webauth with no certificate and no password waits while the controller handles a web sign-in (needs auth-external and verify-client-cert optional)"},
	{"bcast-buffers", .Ignored, .Server, 1, 1, {}, "advanced", "there is no broadcast (layer 3 only)"},
	{"bind", .Supported, .Both, 0, 1, {.Connection}, "link", "bind to a local address and port (the default for servers)"},
	{"bind-dev", .Rejected, .Both, 1, 1, {}, "network", "VRF binding is not supported"},
	{"block-ipv6", .Supported, .Both, 0, 0, {.Pushable}, "network", "drop IPv6 packets at the tunnel, in both directions; no ICMPv6 reply is sent"},
	{"block-outside-dns", .Ignored, .Client, 0, 0, {.Pushable}, "windows", "no effect; there is no firewall filter for DNS"},
	{"bus-allow", .New, .Both, 3, -1, {}, "noirvpn", "map a uid, gid or SID to bus roles: bus-allow uid|gid|sid id role..."},
	{"bus-control", .New, .Both, 1, 5, {}, "noirvpn", "control socket: off, or a path with optional mode and group"},
	{"bus-events", .New, .Both, 1, 5, {}, "noirvpn", "events socket: off, or a path with optional mode and group"},
	{"ca", .Supported, .Both, 1, 1, {.Inline}, "tls", "CA certificates (PEM)"},
	{"capath", .Supported, .Both, 1, 1, {}, "tls", "not available yet (start-up error): use ca with one file"},
	{"ccd-exclusive", .Supported, .Server, 0, 0, {}, "server", "require a client-config-dir file for every client"},
	{"cd", .Supported, .Both, 1, 1, {}, "generic", "change directory before files are read; give an absolute path"},
	{"cert", .Supported, .Both, 1, 1, {.Inline}, "tls", "our certificate (PEM)"},
	{"chroot", .Rejected, .Both, 1, 1, {}, "generic", "chroot is not supported; use the service manager or a container for isolation"},
	{"cipher", .Ignored, .Both, 1, 1, {}, "protocol", "no effect in TLS mode; use data-ciphers"},
	{"client", .Supported, .Client, 0, 0, {}, "client", "client mode: same as pull and tls-client"},
	{"client-cert-not-required", .Rejected, .Server, 0, 0, {}, "removed", "removed in OpenVPN 2.5; every client must present a certificate"},
	{"client-config-dir", .Supported, .Server, 1, 1, {}, "server", "directory of per-client config files"},
	{"client-connect", .Rejected, .Server, 1, 1, {}, "script", "scripts have been removed; subscribe to the peer.connect bus event (noirvpn-hook); per-client settings go in client-config-dir, the peers file or auth.decide"},
	{"client-crresponse", .Rejected, .Server, 1, 1, {}, "script", "challenge and response are handled over the control bus (auth-external)"},
	{"client-disconnect", .Rejected, .Server, 1, 1, {}, "script", "scripts have been removed; subscribe to the peer.disconnect bus event (noirvpn-hook)"},
	{"client-nat", .Rejected, .Client, 4, 4, {.Pushable}, "client", "stateless NAT is not supported"},
	{"client-service", .New, .Client, 0, 0, {}, "noirvpn", "service mode: this config only holds service settings, and the profile is received over the control bus"},
	{"client-to-client", .Supported, .Server, 0, 0, {}, "server", "forward traffic between clients"},
	{"comp-lzo", .Rejected, .Both, 0, 1, {.Pushable}, "protocol", "compression has been removed; delete the line"},
	{"comp-noadapt", .Rejected, .Both, 0, 0, {}, "protocol", "compression has been removed; delete the line"},
	{"compat-mode", .Rejected, .Both, 1, 1, {}, "generic", "peers older than OpenVPN 2.6 are not supported, so there is no compatibility mode"},
	{"compress", .Rejected, .Both, 0, 1, {.Pushable}, "protocol", "compression has been removed; delete the line"},
	{"config", .Supported, .Both, 1, 1, {}, "generic", "include another config file"},
	{"connect-freq", .Supported, .Server, 2, 2, {}, "server", "at most n new connections per sec seconds"},
	{"connect-freq-initial", .Supported, .Server, 2, 2, {}, "server", "at most n initial replies per sec seconds (UDP)"},
	{"connect-freq-source", .New, .Server, 1, 1, {}, "noirvpn", "at most n initial replies for one source address in the connect-freq-initial window (default 20; 0: no limit)"},
	{"connect-retry", .Supported, .Client, 1, 2, {.Connection}, "client", "seconds between connection attempts, and an optional cap for the back-off"},
	{"connect-retry-max", .Supported, .Client, 1, 1, {.Connection}, "client", "number of attempts per remote before giving up"},
	{"connect-timeout", .Supported, .Client, 1, 1, {.Connection}, "client", "seconds to wait for a server before trying the next one"},
	{"connection", .Supported, .Client, 0, 0, {}, "extra", "connection profile block: <connection> ... </connection> with one remote and its own options"},
	{"crl-verify", .Supported, .Both, 1, 2, {.Inline}, "tls", "revocation list: a file with CRLs in PEM (reloaded when it changes), or a directory (with the flag dir) with one file per revoked certificate, named by its serial number; checks the peer certificate chain (ca), not peer-fingerprint"},
	{"cryptoapicert", .Rejected, .Both, 1, 1, {}, "windows", "the Windows certificate store is not supported; put the certificate and key in the config"},
	{"daemon", .Ignored, .Both, 0, 1, {}, "generic", "noirvpn runs in the foreground; use the service manager to run it in the background"},
	{"data-ciphers", .Supported, .Both, 1, 1, {}, "protocol", "colon-separated AEAD ciphers in order of preference"},
	{"data-ciphers-fallback", .Supported, .Both, 1, 1, {}, "protocol", "not applied yet (no warning): the peers must negotiate an AEAD cipher"},
	{"datapath", .New, .Both, 1, 1, {}, "noirvpn", "userspace, dco (the Linux ovpn kernel module), udco (a userspace DCO service) or auto (the kernel module if available, otherwise the service, otherwise this process)"},
	{"dco-socket", .New, .Both, 1, 1, {}, "noirvpn", "socket of the DCO service for `datapath udco` or `auto` (default /run/udco/udco.sock)"},
	{"dev", .Supported, .Both, 1, 1, {}, "network", "tun devices only; dev tap is rejected"},
	{"dev-node", .Ignored, .Both, 1, 1, {}, "network", "no effect"},
	{"dev-type", .Supported, .Both, 1, 1, {}, "network", "only tun is accepted"},
	{"dh", .Ignored, .Server, 1, 1, {.Inline}, "tls", "TLS 1.3 key exchange needs no DH parameters"},
	{"dhcp-option", .Supported, .Client, 1, 3, {.Pushable}, "network", "DNS servers and search domains for the tunnel"},
	{"dhcp-release", .Rejected, .Both, 0, 0, {}, "windows", "the client sets the addresses itself; there is no DHCP"},
	{"dhcp-renew", .Rejected, .Both, 0, 0, {}, "windows", "the client sets the addresses itself; there is no DHCP"},
	{"disable", .Supported, .Server, 0, 0, {.Ccd_Only}, "server", "refuse this client; only valid in a client config file"},
	{"disable-dco", .Supported, .Both, 0, 0, {}, "advanced", "same as datapath userspace; conflicts with datapath dco, udco and auto; in a client service profile, the connections of that profile will run without DCO"},
	{"disable-occ", .Ignored, .Both, 0, 0, {}, "generic", "the options consistency check is not used"},
	{"dns", .Supported, .Client, 1, -1, {.Pushable}, "client", "DNS settings for the tunnel"},
	{"dns-updown", .Rejected, .Client, 1, -1, {}, "script", "noirvpn applies DNS settings itself; they are in the client.tunnel_settings bus event"},
	{"down", .Rejected, .Both, 1, 1, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"down-pre", .Rejected, .Both, 0, 0, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"duplicate-cn", .Supported, .Server, 0, 0, {}, "server", "allow several sessions with the same identity"},
	{"ecdh-curve", .Ignored, .Both, 1, 1, {}, "tls", "use tls-groups"},
	{"echo", .Ignored, .Both, 0, -1, {.Pushable}, "logging", "no effect; there is no management interface"},
	{"engine", .Rejected, .Both, 0, 1, {}, "generic", "OpenSSL engines are not supported"},
	{"errors-to-stderr", .Ignored, .Both, 0, 0, {}, "logging", "logs are already written to standard error"},
	{"explicit-exit-notify", .Supported, .Both, 0, 1, {.Connection}, "client", "tell the peer when this side stops (UDP)"},
	{"extra-certs", .Supported, .Both, 1, 1, {.Inline}, "tls", "extra chain certificates to send"},
	{"fast-io", .Ignored, .Both, 0, 0, {}, "removed", "no effect"},
	{"float", .Supported, .Both, 0, 0, {.Connection}, "link", "accept authenticated packets from a new peer address (server); a client shows a warning that it is not applied"},
	{"force-tls-key-material-export", .Ignored, .Server, 0, 0, {}, "protocol", "the TLS exporter is always used"},
	{"fragment", .Rejected, .Both, 1, 2, {.Connection}, "link", "internal fragmentation has been removed; use mssfix and tun-mtu"},
	{"genkey", .Rejected, .Both, 1, 3, {}, "encryption", "not a daemon option, and noirvpn does not generate keys; use your PKI tools, or openvpn --genkey for static and tls-crypt keys"},
	{"group", .Supported, .Both, 1, 1, {}, "generic", "switch to this group after start-up (Linux only)"},
	{"hand-window", .Supported, .Both, 1, 1, {}, "tls", "how many seconds a handshake may take"},
	{"hash-size", .Ignored, .Server, 2, 3, {}, "advanced", "table sizes are chosen automatically"},
	{"help", .Rejected, .Both, 0, 0, {}, "generic", "this is a command-line flag, not a config option; run noirvpn --help"},
	{"http-proxy", .Supported, .Client, 2, 4, {.Connection}, "proxy", "reach the remote through an HTTP CONNECT proxy: host port [authfile|auto] [none|basic]; only Basic authentication is supported"},
	{"http-proxy-option", .Supported, .Client, 1, 3, {.Connection}, "proxy", "VERSION 1.0|1.1, AGENT string, CUSTOM-HEADER name content"},
	{"http-proxy-retry", .Rejected, .Client, 0, 0, {}, "removed", "removed in OpenVPN 2.4; a failed proxy attempt is retried with the connect-retry back-off"},
	{"http-proxy-timeout", .Rejected, .Client, 1, 1, {}, "removed", "removed in OpenVPN 2.4; connect-timeout covers the proxy exchange"},
	{"http-proxy-user-pass", .Supported, .Client, 1, 1, {.Inline, .Connection}, "proxy", "the credentials for `http-proxy host port auto` (file, or an inline block): user name on line 1, password on line 2"},
	{"ifconfig", .Supported, .Client, 2, 2, {.Pushable}, "network", "tunnel address and netmask; normally pushed by the server"},
	{"ifconfig-ipv6", .Supported, .Client, 1, 2, {.Pushable}, "network", "tunnel IPv6 address; normally pushed by the server"},
	{"ifconfig-ipv6-pool", .Supported, .Server, 1, 1, {}, "server", "set the dynamic IPv6 address range"},
	{"ifconfig-ipv6-push", .Supported, .Server, 1, 2, {.Ccd_Only}, "server", "fixed IPv6 tunnel address for one client; only valid in a client config file"},
	{"ifconfig-noexec", .Supported, .Both, 0, 0, {}, "network", "do not configure the interface; only report the settings on the bus"},
	{"ifconfig-nowarn", .Ignored, .Both, 0, 0, {}, "network", "no effect"},
	{"ifconfig-pool", .Supported, .Server, 2, 3, {}, "server", "set the dynamic address range (overrides the range derived from server)"},
	{"ifconfig-pool-linear", .Rejected, .Server, 0, 0, {}, "removed", "removed in OpenVPN 2.5 (it meant topology p2p, which is not supported)"},
	{"ifconfig-pool-persist", .Supported, .Server, 1, 2, {}, "server", "remember client addresses in a file"},
	{"ifconfig-push", .Supported, .Server, 2, 3, {.Ccd_Only}, "server", "fixed tunnel address for one client; only valid in a client config file"},
	{"ignore-unknown-option", .Supported, .Both, 1, -1, {}, "generic", "do not stop with an error on these unknown options"},
	{"inactive", .Supported, .Both, 1, 2, {.Pushable}, "client", "disconnect after n seconds without tunnel traffic; a client only applies it from its own config, and a server ignores it with a warning"},
	{"ip-win32", .Ignored, .Client, 1, 3, {.Pushable}, "windows", "no effect; the client sets the addresses through the IP Helper API"},
	{"ipchange", .Rejected, .Both, 1, -1, {}, "script", "scripts have been removed; subscribe to the peer.float bus event (noirvpn-hook)"},
	{"iproute", .Ignored, .Both, 1, 1, {}, "generic", "routes and addresses are set through netlink, not an external command"},
	{"iroute", .Supported, .Server, 1, 2, {.Ccd_Only}, "server", "subnet behind one client; only valid in a client config file or the peers file"},
	{"iroute-ipv6", .Supported, .Server, 1, 1, {.Ccd_Only}, "server", "IPv6 subnet behind one client; only valid in a client config file"},
	{"keepalive", .Supported, .Both, 2, 2, {}, "link", "ping interval and timeout; a server pushes them to clients"},
	{"key", .Supported, .Both, 1, 1, {.Inline}, "tls", "our private key (PEM)"},
	{"key-direction", .Supported, .Both, 1, 1, {.Connection}, "protocol", "0 or 1; selects which halves of the tls-auth key are used"},
	{"key-method", .Rejected, .Both, 1, 1, {}, "removed", "removed in OpenVPN 2.5; only key method 2 exists"},
	{"keying-material-exporter", .Rejected, .Both, 2, 2, {}, "generic", "only plugins used this, and plugins have been removed"},
	{"learn-address", .Rejected, .Server, 1, 1, {}, "script", "scripts have been removed; subscribe to the peer.connect bus event (noirvpn-hook)"},
	{"link-mtu", .Ignored, .Both, 1, 1, {.Connection}, "link", "deprecated; use tun-mtu"},
	{"lladdr", .Rejected, .Both, 1, 1, {}, "network", "link-layer addresses need TAP, which is not supported"},
	{"local", .Supported, .Both, 1, 3, {.Connection}, "link", "local address, port and protocol (a server may list several)"},
	{"log", .Ignored, .Both, 1, 1, {}, "logging", "logs are written to standard error; redirect them in the service manager"},
	{"log-append", .Ignored, .Both, 1, 1, {}, "logging", "logs are written to standard error; redirect them in the service manager"},
	{"lport", .Supported, .Both, 1, 1, {.Connection}, "link", "local port"},
	{"machine-readable-output", .Ignored, .Both, 0, 0, {}, "logging", "no effect"},
	{"management", .Rejected, .Both, 1, 3, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-client", .Rejected, .Both, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-client-auth", .Rejected, .Server, 0, 0, {}, "management", "the text management interface has been removed; use auth-external and the control bus"},
	{"management-client-group", .Rejected, .Both, 1, 1, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-client-pf", .Rejected, .Both, 0, 1, {}, "removed", "removed in OpenVPN 2.6; the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-client-user", .Rejected, .Both, 1, 1, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-external-cert", .Rejected, .Client, 1, 1, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-external-key", .Rejected, .Client, 0, 3, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-forget-disconnect", .Rejected, .Both, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-hold", .Rejected, .Both, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-log-cache", .Rejected, .Both, 1, 1, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-query-passwords", .Rejected, .Client, 0, 0, {}, "management", "the text management interface has been removed; credentials are requested with the client.auth_needed bus event"},
	{"management-query-proxy", .Rejected, .Client, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-query-remote", .Rejected, .Client, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-signal", .Rejected, .Both, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"management-up-down", .Rejected, .Both, 0, 0, {}, "management", "the text management interface has been removed; use the control bus (noirvpnctl)"},
	{"mark", .Supported, .Both, 1, 1, {}, "link", "not applied yet (warning): the firewall mark is not set on the socket"},
	{"max-clients", .Supported, .Server, 1, 1, {}, "server", "maximum number of concurrent clients (default 1024)"},
	{"max-packet-size", .Supported, .Both, 1, 1, {}, "link", "control packet size limit; also sets mssfix"},
	{"max-routes", .Ignored, .Both, 1, 1, {}, "removed", "removed in OpenVPN 2.4; there is no route limit"},
	{"max-routes-per-client", .Supported, .Server, 1, 1, {.Ccd}, "server", "maximum number of internal routes per client (default 256)"},
	{"mktun", .Rejected, .Both, 0, 0, {}, "network", "standalone operation is not available; create persistent devices with ip tuntap add"},
	{"mlock", .Supported, .Both, 0, 0, {}, "generic", "not applied yet (warning): memory is not locked"},
	{"mode", .Supported, .Both, 1, 1, {}, "link", "only server is accepted; p2p is not supported"},
	{"mssfix", .Supported, .Both, 0, 2, {.Connection}, "link", "clamp the TCP MSS of connections in the tunnel; N is the largest data channel packet, mtu: the largest outer IP packet, fixed: the largest inner packet"},
	{"mtu-disc", .Supported, .Both, 1, 1, {.Connection}, "link", "not applied yet (warning): the path MTU discovery mode of the socket is not set"},
	{"mtu-test", .Rejected, .Both, 0, 0, {}, "link", "not supported; noirvpn does not probe the path MTU, so set tun-mtu and mssfix by hand"},
	{"multihome", .Supported, .Server, 0, 1, {}, "server", "accepted but not needed, because a UDP server always replies from the address the client used; same-interface also replies through the interface the client used"},
	{"mute", .Ignored, .Both, 1, 1, {}, "logging", "no effect"},
	{"mute-replay-warnings", .Ignored, .Both, 0, 0, {}, "logging", "no effect"},
	{"ncp-ciphers", .Supported, .Both, 1, 1, {}, "extra", "old name of data-ciphers"},
	{"ncp-disable", .Ignored, .Both, 0, 0, {}, "removed", "cipher negotiation is always on"},
	{"nice", .Ignored, .Both, 1, 1, {}, "generic", "set the priority in the service manager instead"},
	{"no-iv", .Rejected, .Both, 0, 0, {}, "removed", "removed; the data channel only uses AEAD"},
	{"no-replay", .Rejected, .Both, 0, 0, {}, "removed", "removed; replay protection is always on"},
	{"nobind", .Supported, .Client, 0, 0, {.Connection}, "link", "do not bind a local port"},
	{"ns-cert-type", .Rejected, .Both, 1, 1, {}, "tls", "deprecated; use remote-cert-tls"},
	{"opt-verify", .Ignored, .Both, 0, 0, {}, "removed", "the options consistency check is not used"},
	{"override-username", .Rejected, .Server, 1, 1, {}, "server", "the identity comes from the pinned key or the control bus (auth-external)"},
	{"passtos", .Ignored, .Both, 0, 0, {}, "link", "no effect"},
	{"pause-exit", .Rejected, .Both, 0, 0, {}, "windows", "not supported; there is no pause at exit"},
	{"peer-fingerprint", .Supported, .Both, 1, -1, {.Inline}, "tls", "SHA-256 fingerprints of accepted peer certificates"},
	{"peer-keys", .New, .Server, 1, 1, {}, "noirvpn", "peers file: one pinned key per line (username, pin, options)"},
	{"peer-keys-mode", .New, .Server, 1, 1, {}, "noirvpn", "pin (default), both (chain and pin) or either (a pin, or else a chain); both and either need ca and peer-keys; ca with peer-keys and no mode is the same as either"},
	{"peer-passwords", .New, .Server, 1, 1, {}, "noirvpn", "file of user names and password hashes; the server checks the password of a client against it; a password source for verify-client-cert optional"},
	{"persist-key", .Ignored, .Both, 0, 0, {}, "removed", "keys are always kept across restarts"},
	{"persist-local-ip", .Ignored, .Both, 0, 0, {}, "advanced", "no effect"},
	{"persist-remote-ip", .Ignored, .Both, 0, 0, {}, "advanced", "no effect; a failed name lookup always uses the addresses of the last successful lookup"},
	{"persist-tun", .Supported, .Both, 0, 0, {.Pushable}, "network", "a client keeps its tun device, addresses and routes across reconnects; a server keeps its device for its whole run anyway"},
	{"ping", .Supported, .Both, 1, 1, {.Pushable}, "link", "send a ping after n idle seconds"},
	{"ping-exit", .Supported, .Both, 1, 1, {.Pushable}, "link", "not applied yet (warning): it only turns off the default ping-restart"},
	{"ping-restart", .Supported, .Both, 1, 1, {.Pushable}, "link", "restart after n seconds without receiving a packet"},
	{"ping-timer-rem", .Supported, .Both, 0, 0, {}, "link", "run the ping timers only when a peer is known"},
	{"pkcs11-cert-private", .Rejected, .Both, 1, -1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-id", .Rejected, .Both, 1, 1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-id-management", .Rejected, .Both, 0, 0, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-pin-cache", .Rejected, .Both, 1, 1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-private-mode", .Rejected, .Both, 1, -1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-protected-authentication", .Rejected, .Both, 0, -1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs11-providers", .Rejected, .Both, 1, -1, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"pkcs12", .Rejected, .Both, 1, 1, {.Inline}, "tls", "PKCS#12 bundles are not supported; split them into ca, cert and key with openssl pkcs12"},
	{"plugin", .Rejected, .Both, 1, -1, {}, "plugin", "the plugin interface has been removed; use the control bus"},
	{"port", .Supported, .Both, 1, 1, {.Connection}, "link", "local and remote port"},
	{"port-share", .Rejected, .Server, 2, 3, {}, "server", "port sharing is not supported"},
	{"pq-mode", .New, .Both, 1, 1, {}, "noirvpn", "off, prefer (default) or require the hybrid post-quantum key exchange"},
	{"preresolve", .Ignored, .Client, 0, 0, {}, "client", "host names are resolved when connecting"},
	{"prng", .Ignored, .Both, 1, 2, {}, "removed", "the random generator of the crypto library is always used"},
	{"proto", .Supported, .Both, 1, 1, {.Connection}, "link", "udp, tcp-client, tcp-server, tls-client or tls-server (TCP in an outer TLS stream, noirvpn to noirvpn), with 4 or 6 for one IP version"},
	{"proto-force", .Supported, .Client, 1, 1, {}, "client", "only use remotes with this transport protocol"},
	{"providers", .Rejected, .Both, 1, -1, {}, "generic", "the crypto library is chosen at build time"},
	{"pull", .Supported, .Client, 0, 0, {}, "client", "accept options pushed by the server"},
	{"pull-filter", .Supported, .Client, 2, 2, {}, "client", "accept, ignore or reject pushed options by prefix"},
	{"push", .Supported, .Server, 1, 1, {.Ccd}, "server", "send an option to clients"},
	{"push-peer-info", .Supported, .Client, 0, 0, {}, "client", "not applied yet (warning): no extra client details are sent"},
	{"push-remove", .Supported, .Server, 1, 1, {.Ccd_Only}, "server", "drop matching pushed options for one client; only valid in a client config file"},
	{"push-reset", .Supported, .Server, 0, 0, {.Ccd_Only}, "server", "drop all inherited pushed options for one client; only valid in a client config file"},
	{"rcvbuf", .Supported, .Both, 1, 1, {.Pushable}, "advanced", "socket receive buffer size"},
	{"redirect-gateway", .Supported, .Client, 0, -1, {.Pushable}, "network", "send all IP traffic through the tunnel"},
	{"redirect-private", .Supported, .Client, 0, -1, {.Pushable}, "network", "like redirect-gateway, but the default route is not changed"},
	{"register-dns", .Rejected, .Both, 0, 0, {}, "windows", "DNS registration is not supported"},
	{"remap-usr1", .Ignored, .Both, 1, 1, {}, "generic", "no effect"},
	{"remote", .Supported, .Client, 1, 3, {.Connection}, "client", "server host, port and protocol"},
	{"remote-cert-eku", .Supported, .Both, 1, 1, {}, "tls", "the certificate of the peer must have this extended key usage (an OID, or a short or long name)"},
	{"remote-cert-ku", .Supported, .Both, 0, -1, {}, "tls", "the certificate of the peer must have a key usage with at least all the bits of one value (hex, 1 to ff, e.g. a0); with no value, it only needs to have a key usage"},
	{"remote-cert-tls", .Supported, .Both, 1, 1, {}, "tls", "the certificate of the peer must have a key usage and the extended key usage of a server (TLS Web Server Authentication) or of a client (TLS Web Client Authentication)"},
	{"remote-random", .Supported, .Client, 0, 0, {}, "client", "shuffle the remote list at start-up"},
	{"remote-random-hostname", .Ignored, .Client, 0, 0, {}, "client", "host names are resolved as written"},
	{"reneg-bytes", .Supported, .Both, 1, 1, {}, "renegotiation", "renegotiate after n bytes"},
	{"reneg-pkts", .Supported, .Both, 1, 1, {}, "renegotiation", "renegotiate after n packets"},
	{"reneg-sec", .Supported, .Both, 1, 2, {.Pushable}, "renegotiation", "renegotiate after at most max and at least min seconds"},
	{"replay-persist", .Rejected, .Both, 1, 1, {}, "link", "not supported; replay state is kept in memory and every restart uses new session keys, so there is nothing to save"},
	{"replay-window", .Supported, .Both, 1, 2, {}, "link", "not applied yet (warning): the default replay window of the data channel is used"},
	{"resolv-retry", .Supported, .Client, 1, 1, {}, "client", "seconds to retry name resolution, or infinite"},
	{"rmtun", .Rejected, .Both, 0, 0, {}, "network", "standalone operation is not available; remove persistent devices with ip tuntap del"},
	{"route", .Supported, .Both, 1, 4, {.Pushable}, "network", "add a route: network, netmask, gateway, metric"},
	{"route-delay", .Ignored, .Client, 0, 2, {.Pushable}, "network", "routes are added as soon as the tunnel is up"},
	{"route-gateway", .Supported, .Client, 1, 1, {.Pushable}, "network", "default gateway for routes"},
	{"route-ipv6", .Supported, .Both, 1, 3, {.Pushable}, "network", "add an IPv6 route: prefix, gateway, metric"},
	{"route-ipv6-gateway", .Supported, .Client, 1, 1, {.Pushable}, "network", "default gateway for IPv6 routes"},
	{"route-method", .Ignored, .Both, 1, 1, {}, "windows", "no effect; the client sets the routes through the IP Helper API"},
	{"route-metric", .Supported, .Client, 1, 1, {.Pushable}, "network", "default metric for routes"},
	{"route-noexec", .Supported, .Both, 0, 0, {}, "network", "do not add routes; only report them on the bus"},
	{"route-nopull", .Supported, .Client, 0, 0, {}, "network", "ignore pushed routes and DNS options"},
	{"route-pre-down", .Rejected, .Both, 1, 1, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"route-table", .Supported, .Both, 1, 1, {}, "network", "routing table id for routes (Linux)"},
	{"route-up", .Rejected, .Both, 1, 1, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"rport", .Supported, .Client, 1, 1, {.Connection}, "link", "remote port"},
	{"script-security", .Ignored, .Both, 1, 2, {}, "generic", "scripts are not supported, so there is nothing to secure"},
	{"secret", .Rejected, .Both, 1, 2, {}, "extra", "static-key mode has been removed; use TLS"},
	{"server", .Supported, .Server, 2, 3, {}, "server", "server mode: network, netmask and optional nopool"},
	{"server-bridge", .Rejected, .Server, 0, 4, {}, "server", "bridging needs TAP, which is not supported"},
	{"server-ipv6", .Supported, .Server, 1, 1, {}, "server", "IPv6 network for the tunnel"},
	{"server-poll-timeout", .Supported, .Client, 1, 1, {}, "client", "same as connect-timeout"},
	{"service", .Rejected, .Both, 1, 2, {}, "windows", "use noirvpn service install instead"},
	{"session-timeout", .Supported, .Both, 1, 1, {.Pushable, .Ccd}, "link", "end the session after n seconds; a server only applies it in a client-config-dir file, and a client only from its own config"},
	{"setcon", .Rejected, .Both, 1, 1, {}, "generic", "SELinux contexts are not set by noirvpn; use the service manager policy"},
	{"setenv", .Ignored, .Both, 1, -1, {.Pushable}, "script", "scripts have been removed, so there is no environment; setenv opt, setenv FORWARD_COMPATIBLE 1 and setenv IV_SSO still work"},
	{"setenv-safe", .Ignored, .Both, 1, 2, {}, "script", "scripts have been removed, so there is no environment"},
	{"shaper", .Rejected, .Both, 1, 1, {}, "advanced", "traffic shaping has been removed; use the operating system (tc)"},
	{"show-adapters", .Rejected, .Both, 0, 0, {}, "windows", "not supported; use Get-NetAdapter"},
	{"show-ciphers", .Rejected, .Both, 0, 0, {}, "encryption", "standalone operation is not available"},
	{"show-digests", .Rejected, .Both, 0, 0, {}, "encryption", "standalone operation is not available"},
	{"show-engines", .Rejected, .Both, 0, 0, {}, "encryption", "standalone operation is not available"},
	{"show-gateway", .Rejected, .Both, 0, 1, {}, "advanced", "standalone operation is not available"},
	{"show-groups", .Rejected, .Both, 0, 0, {}, "encryption", "standalone operation is not available"},
	{"show-net", .Rejected, .Both, 0, 0, {}, "windows", "not supported; use route print"},
	{"show-net-up", .Rejected, .Both, 0, 0, {}, "windows", "not supported; use route print"},
	{"show-pkcs11-ids", .Rejected, .Both, 0, 2, {}, "pkcs11", "PKCS#11 is not supported; use a PEM key and certificate file"},
	{"show-tls", .Rejected, .Both, 0, 0, {}, "encryption", "standalone operation is not available"},
	{"show-valid-subnets", .Rejected, .Both, 0, 0, {}, "windows", "not supported; there is no TAP adapter"},
	{"single-session", .Rejected, .Both, 0, 0, {}, "client", "not supported; to stop a key from reconnecting, mark it disabled in the peers file or use disable in its client-config-dir file"},
	{"sndbuf", .Supported, .Both, 1, 1, {.Pushable}, "advanced", "socket send buffer size"},
	{"socket-flags", .Ignored, .Both, 1, -1, {.Pushable}, "link", "TCP_NODELAY is always on"},
	{"socks-proxy", .Rejected, .Client, 1, 3, {.Connection}, "proxy", "SOCKS is not supported; use http-proxy (an HTTP CONNECT proxy), or route the connection with the operating system"},
	{"socks-proxy-retry", .Rejected, .Client, 0, 0, {}, "removed", "removed in OpenVPN 2.4; SOCKS is not supported"},
	{"stale-routes-check", .Ignored, .Server, 1, 2, {}, "server", "only learned (TAP) routes age out"},
	{"static-challenge", .Rejected, .Client, 2, 3, {}, "client", "challenge and response are handled over the control bus (auth-external)"},
	{"stats-interval", .New, .Both, 1, 1, {}, "noirvpn", "publish a stats.tick bus event every n seconds (0 or not set: off)"},
	{"status", .Rejected, .Both, 1, 2, {}, "generic", "the status file has been removed; use the control bus status request (noirvpnctl status)"},
	{"status-version", .Rejected, .Server, 1, 1, {}, "generic", "the status file has been removed; use the control bus status request (noirvpnctl status)"},
	{"suppress-timestamps", .Ignored, .Both, 0, 0, {}, "logging", "no effect"},
	{"syslog", .Ignored, .Both, 0, 1, {}, "logging", "logs are written to standard error; redirect them in the service manager"},
	{"tap-sleep", .Rejected, .Both, 1, 1, {}, "windows", "there is no TAP adapter; noirvpn uses wintun"},
	{"tcp-nodelay", .Ignored, .Server, 0, 0, {}, "link", "TCP_NODELAY is always on"},
	{"tcp-queue-limit", .Ignored, .Server, 1, 1, {}, "advanced", "queue sizes are chosen automatically"},
	{"test-crypto", .Rejected, .Both, 0, 0, {}, "generic", "standalone operation is not available"},
	{"tls-auth", .Supported, .Both, 1, 2, {.Inline, .Connection}, "tls", "HMAC-protect control packets; optional key direction"},
	{"tls-cert-profile", .Ignored, .Both, 1, 1, {}, "tls", "TLS algorithm policy is fixed by noirvpn"},
	{"tls-cipher", .Ignored, .Both, 1, 1, {}, "tls", "TLS algorithm policy is fixed by noirvpn"},
	{"tls-ciphersuites", .Ignored, .Both, 1, 1, {}, "tls", "TLS algorithm policy is fixed by noirvpn"},
	{"tls-client", .Supported, .Client, 0, 0, {}, "tls", "TLS client role (included in client)"},
	{"tls-crypt", .Supported, .Both, 1, 1, {.Inline, .Connection}, "tls", "encrypt and authenticate control packets with a shared key"},
	{"tls-crypt-v2", .Supported, .Both, 1, 2, {.Inline, .Connection}, "tls", "per-client control keys; force-cookie or allow-noncookie on servers"},
	{"tls-crypt-v2-max-age", .Supported, .Server, 1, 1, {}, "tls", "reject client keys older than n days"},
	{"tls-crypt-v2-verify", .Rejected, .Server, 1, 1, {}, "tls", "scripts have been removed; limit client key age with tls-crypt-v2-max-age"},
	{"tls-exit", .Ignored, .Both, 0, 0, {}, "tls", "no effect"},
	{"tls-export-cert", .Rejected, .Server, 1, 1, {}, "script", "not supported; certificate details are in the peer.handshake bus event"},
	{"tls-groups", .Supported, .Both, 1, 1, {}, "tls", "allowed TLS key exchange groups"},
	{"tls-server", .Supported, .Server, 0, 0, {}, "tls", "TLS server role"},
	{"tls-timeout", .Supported, .Both, 1, 1, {}, "tls", "control packet retransmit timeout in seconds"},
	{"tls-transport-accept-tcp", .New, .Server, 0, 0, {}, "noirvpn", "every proto tls-server listener also accepts raw OpenVPN tcp-client connections on the same port (identified by the first 3 bytes)"},
	{"tls-transport-cert", .New, .Server, 1, 1, {.Inline}, "noirvpn", "certificate (leaf first, then the chain; PEM) for the outer TLS of proto tls-server; default: cert"},
	{"tls-transport-dev", .New, .Server, 1, 1, {}, "noirvpn", "name of the second tun device for the proto tls-server clients under datapath dco or udco; default: the dev name with -tls added"},
	{"tls-transport-hello", .New, .Client, 1, 1, {}, "noirvpn", "the ClientHello sent in the outer TLS of proto tls-client: default (what the TLS library sends) or chrome (Chrome's cipher list, signature algorithms, ALPN, session ticket and more, as far as the library allows); it also sets the headers of the WebSocket upgrade request with tls-transport-ws"},
	{"tls-transport-key", .New, .Server, 1, 1, {.Inline}, "noirvpn", "private key (PEM) for the outer TLS of proto tls-server; default: key"},
	{"tls-transport-sni", .New, .Client, 1, 1, {}, "noirvpn", "server name in the outer TLS of proto tls-client; default: the remote host name, none for an address"},
	{"tls-transport-strict", .New, .Client, 0, 0, {}, "noirvpn", "refuse the connection when the outer TLS certificate does not match the server's key (which means another party terminates the outer TLS)"},
	{"tls-transport-ws", .New, .Both, 1, 1, {}, "noirvpn", "send the tls transport in a WebSocket at this path: a tls-client sends the HTTP upgrade request, tls-server and tcp-server listeners respond to it (for a reverse proxy that terminates the outer TLS at the HTTP layer)"},
	{"tls-verify", .Rejected, .Both, 1, 1, {}, "script", "scripts have been removed; pin keys with peer-keys or decide over the control bus (auth-external)"},
	{"tls-version-max", .Supported, .Both, 1, 1, {}, "tls", "the highest TLS version of the control channel, 1.2 or 1.3"},
	{"tls-version-min", .Supported, .Both, 1, 2, {}, "tls", "the lowest TLS version of the control channel, 1.2 or 1.3; 1.0 and 1.1 cause a warning and are treated as 1.2; an unknown version with or-highest is treated as 1.3"},
	{"tmp-dir", .Ignored, .Both, 1, 1, {}, "generic", "noirvpn does not write temporary files"},
	{"topology", .Supported, .Both, 1, 1, {.Pushable}, "network", "only subnet is accepted; net30 and p2p are not supported"},
	{"tran-window", .Supported, .Both, 1, 1, {}, "protocol", "seconds an old key stays valid after a renegotiation"},
	{"tun-ipv6", .Ignored, .Client, 0, 0, {.Pushable}, "extra", "no effect; IPv6 is enabled by ifconfig-ipv6"},
	{"tun-mtu", .Supported, .Both, 1, 2, {.Pushable, .Connection}, "network", "tunnel MTU, and an optional MTU to announce"},
	{"tun-mtu-extra", .Ignored, .Both, 1, 1, {.Connection}, "network", "no effect"},
	{"tun-mtu-max", .Ignored, .Both, 1, 1, {}, "network", "no effect"},
	{"txqueuelen", .Supported, .Both, 1, 1, {}, "advanced", "tun transmit queue length"},
	{"up", .Rejected, .Both, 1, 1, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"up-delay", .Rejected, .Both, 0, 0, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"up-restart", .Rejected, .Both, 0, 0, {}, "script", "scripts have been removed; subscribe to the client.state and client.tunnel_settings bus events (noirvpn-hook)"},
	{"use-prediction-resistance", .Ignored, .Both, 0, 0, {}, "removed", "no effect"},
	{"user", .Supported, .Both, 1, 1, {}, "generic", "switch to this user after start-up and keep only CAP_NET_ADMIN (Linux only)"},
	{"username-as-common-name", .Rejected, .Server, 0, 0, {}, "server", "the identity comes from the pinned key or the control bus (auth-external)"},
	{"verb", .Supported, .Both, 1, 1, {}, "logging", "log verbosity, 0 to 11"},
	{"verify-client-cert", .Supported, .Server, 1, 1, {}, "server", "require (default), or optional: a client without a certificate logs in with a user name and password (needs peer-passwords or auth-external), and any certificate that is sent must still pass. With no ca, peer-keys or peer-fingerprint, the server does not ask for a certificate at all and only accepts password logins. none is not supported"},
	{"verify-hash", .Rejected, .Both, 1, 2, {.Inline}, "tls", "deprecated; use peer-fingerprint"},
	{"verify-x509-name", .Supported, .Both, 1, 2, {}, "tls", "the certificate of the peer must have this name: the whole subject (type subject, the default), the common name (name) or the start of it (name-prefix); x509-username-field is not applied, so the common name is used"},
	{"vlan-accept", .Rejected, .Server, 1, 1, {}, "server", "VLANs need TAP, which is not supported"},
	{"vlan-pvid", .Rejected, .Server, 1, 1, {}, "server", "VLANs need TAP, which is not supported"},
	{"vlan-tagging", .Rejected, .Server, 0, 0, {}, "server", "VLANs need TAP, which is not supported"},
	{"win-sys", .Rejected, .Both, 1, 1, {}, "windows", "not needed; noirvpn does not run system programs"},
	{"windows-driver", .Rejected, .Both, 1, 1, {}, "removed", "removed in OpenVPN 2.7; noirvpn uses wintun"},
	{"workers", .New, .Both, 1, 1, {}, "noirvpn", "crypto worker threads for the data channel (0 means none, the default; peers are spread across the threads)"},
	{"writepid", .Supported, .Both, 1, 1, {}, "generic", "write the process id to this file"},
	{"x509-track", .Rejected, .Both, 1, 1, {}, "tls", "environment variables have been removed; certificate details are in bus events"},
	{"x509-username-field", .Supported, .Server, 1, 1, {}, "tls", "not applied yet (no warning): the client identity is the common name (CN)"},
}
//odinfmt: enable
