package session

import "core:encoding/hex"
import "core:encoding/json"
import "core:strings"
import "core:testing"
import "core:time"
import "noir:proto/crypt"
import "noir:proto/keys"
import "noir:proto/push"
import "noir:proto/wrap"

// Replays of packets that stock OpenVPN 2.6.23 and 2.7.7 really sent (the files
// in proto/testdata/vectors/, generated by the interop harness). They check the
// session against the stock peers without any server code of ours in the loop.

TLS_AUTH_VECTORS := #load("../testdata/vectors/tls-auth.json")
TLS_CRYPT_VECTORS := #load("../testdata/vectors/tls-crypt.json")
TLS_CRYPT_V2_VECTORS := #load("../testdata/vectors/tls-crypt-v2.json")
PUSH_VECTORS := #load("../testdata/vectors/control-push.json")
DATA_VECTORS := #load("../testdata/vectors/data-channel.json")

vec_load :: proc(t: ^testing.T, text: []u8) -> (root: json.Object, ok: bool) {
	v, err := json.parse(text, allocator = context.temp_allocator)
	if err != .None {
		testing.expectf(t, false, "vector file does not parse: %v", err)
		return nil, false
	}
	obj, is_obj := v.(json.Object)
	return obj, is_obj
}

vec_str :: proc(o: json.Object, key: string) -> string {
	v, ok := o[key]
	if !ok {
		return ""
	}
	s, _ := v.(json.String)
	return string(s)
}

vec_int :: proc(o: json.Object, key: string) -> int {
	v, ok := o[key]
	if !ok {
		return 0
	}
	#partial switch x in v {
	case json.Integer:
		return int(x)
	case json.Float:
		return int(x)
	}
	return 0
}

vec_obj :: proc(o: json.Object, key: string) -> json.Object {
	v, _ := o[key]
	r, _ := v.(json.Object)
	return r
}

vec_arr :: proc(o: json.Object, key: string) -> json.Array {
	v, _ := o[key]
	r, _ := v.(json.Array)
	return r
}

unhex :: proc(s: string) -> []u8 {
	// A full length means the decode worked, on every Odin version.
	b, _ := hex.decode(transmute([]u8)s, context.temp_allocator)
	if len(b) * 2 != len(s) {
		panic("bad hex in a vector")
	}
	return b
}

// Fixed "random" source: the first call gives the session id of the vector.
Fixed_Sid :: struct {
	sid: [8]u8,
}

fixed_random :: proc(user: rawptr, buf: []u8) -> bool {
	f := (^Fixed_Sid)(user)
	for i in 0 ..< len(buf) {
		buf[i] = f.sid[i % 8] ~ u8(i / 8)
	}
	return true
}

// The first packet of the client is byte for byte what stock clients sent, and
// the stock server's reset is accepted. Bad copies are rejected.
vec_first_flight :: proc(t: ^testing.T, c: json.Object, mode: Wrap_Mode, name: string) {
	pkts := vec_arr(c, "packets")
	if len(pkts) < 2 {
		testing.expectf(t, false, "%s: too few packets", name)
		return
	}
	p0 := pkts[0].(json.Object)
	p1 := pkts[1].(json.Object)
	d0 := vec_obj(p0, "decode")
	d1 := vec_obj(p1, "decode")
	want := unhex(vec_str(p0, "wire_hex"))
	srv_reset := unhex(vec_str(p1, "wire_hex"))
	sid := unhex(vec_str(d0, "session_id"))
	srv_sid := unhex(vec_str(d1, "session_id"))
	tcp := vec_str(c, "transport") == "tcp"

	cfg := Config {
		transport = .Tcp if tcp else .Udp,
		cert_pem  = CLIENT_CRT,
		key_pem   = CLIENT_KEY,
		ca_pem    = CA_PEM,
	}
	cfg.wrap.mode = mode
	key: wrap.Static_Key
	ck: wrap.Client_Key
	switch mode {
	case .None:
	case .Tls_Auth:
		kb := unhex(vec_str(c, "static_key_hex"))
		copy(key.bytes[:], kb)
		cfg.wrap.static_key = &key
		cfg.wrap.auth_digest = .SHA1 if vec_str(c, "digest") == "SHA1" else .SHA256
		if strings.has_prefix(vec_str(c, "key_direction"), "client=1") {
			cfg.wrap.key_direction = .One
		}
	case .Tls_Crypt:
		kb := unhex(vec_str(c, "static_key_hex"))
		copy(key.bytes[:], kb)
		cfg.wrap.static_key = &key
	case .Tls_Crypt_V2:
		copy(ck.kc.bytes[:], unhex(vec_str(c, "client_key_Kc_hex")))
		wkc := unhex(vec_str(c, "wkc_hex"))
		copy(ck.wkc[:], wkc)
		ck.wkc_len = len(wkc)
		cfg.wrap.client_key = &ck
	}
	fs := Fixed_Sid{}
	copy(fs.sid[:], sid)
	cfg.random = fixed_random
	cfg.random_user = &fs

	// Round 0 sends damaged packets (a UDP session drops them, a TCP session
	// ends). Round 1 sends the real reset.
	for round in 0 ..< 2 {
		s: Session
		if !testing.expectf(t, session_init(&s, &cfg) == .None, "%s: session_init", name) {
			return
		}
		defer session_destroy(&s)
		now := time.Second
		if !testing.expectf(t, session_start(&s, now, i64(vec_int(d0, "wrap_time"))) == .None, "%s: session_start", name) {
			return
		}
		out: [LINK_BUF_SIZE]u8
		n := session_poll_tx(&s, out[:], now)
		got := out[:n]
		if tcp {
			got = got[2:]
		}
		testing.expectf(t, string(got) == string(want), "%s: first packet differs\n got  %x\n want %x", name, got, want)
		if round == 0 {
			for item in vec_arr(c, "negative") {
				o := item.(json.Object)
				if vec_str(o, "dir") != "s2c" {
					continue
				}
				bad := unhex(vec_str(o, "wire_hex"))
				if tcp {
					bad = frame(bad)
				}
				session_receive(&s, bad, now)
				testing.expectf(t, !s.peer_sid_set, "%s: a damaged server packet was accepted", name)
				testing.expectf(t, (s.state == .Failed) == tcp, "%s: a damaged packet must end a TCP session only", name)
				if s.state == .Failed {
					break
				}
			}
			continue
		}
		pkt := srv_reset
		if tcp {
			pkt = frame(srv_reset)
		}
		session_receive(&s, pkt, now)
		testing.expectf(t, s.peer_sid_set, "%s: the stock server reset was not accepted", name)
		testing.expectf(t, string(s.peer_sid[:]) == string(srv_sid), "%s: wrong server session id", name)
		ev, ok := session_next_event(&s)
		testing.expectf(t, ok && ev.kind == .Link_Up, "%s: no Link_Up", name)
		// The early-negotiation flag of a 2.7 server reset (tls-crypt-v2, UDP).
		if mode == .Tls_Crypt_V2 && !tcp {
			payload := vec_str(d1, "payload_hex")
			testing.expectf(t, s.ks.resend_wkc == (payload == "000100020001"), "%s: early-negotiation flag mismatch", name)
		}
		// The same reset again is a duplicate on UDP (a stock server resends it
		// when our ack is lost): dropped, no failure.
		if !tcp {
			session_receive(&s, pkt, now)
			testing.expectf(t, s.state != .Failed, "%s: failed on a duplicate reset", name)
		}
	}
}

frame :: proc(p: []u8) -> []u8 {
	r := make([]u8, len(p) + 2, context.temp_allocator)
	r[0], r[1] = u8(len(p) >> 8), u8(len(p))
	copy(r[2:], p)
	return r
}

@(test)
test_vectors_tls_auth :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, TLS_AUTH_VECTORS)
	if !ok {
		return
	}
	cases := vec_arr(root, "cases")
	testing.expect(t, len(cases) >= 4, "too few tls-auth cases")
	for c in cases {
		o := c.(json.Object)
		vec_first_flight(t, o, .Tls_Auth, vec_str(o, "cell"))
	}
}

@(test)
test_vectors_tls_crypt :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, TLS_CRYPT_VECTORS)
	if !ok {
		return
	}
	cases := vec_arr(root, "cases")
	testing.expect(t, len(cases) >= 3, "too few tls-crypt cases")
	for c in cases {
		o := c.(json.Object)
		vec_first_flight(t, o, .Tls_Crypt, vec_str(o, "cell"))
	}
}

@(test)
test_vectors_tls_crypt_v2 :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, TLS_CRYPT_V2_VECTORS)
	if !ok {
		return
	}
	cases := vec_arr(root, "cases")
	testing.expect(t, len(cases) >= 4, "too few tls-crypt-v2 cases")
	for c in cases {
		o := c.(json.Object)
		vec_first_flight(t, o, .Tls_Crypt_V2, vec_str(o, "cell"))
	}
}

// ----------------------------------------------------------------- PUSH_REPLY

@(test)
test_vectors_push_replies :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, PUSH_VECTORS)
	if !ok {
		return
	}
	n_up, n_epoch := 0, 0
	for c in vec_arr(root, "cases") {
		o := c.(json.Object)
		name := vec_str(o, "name")
		expect := vec_obj(o, "expect")
		if _, token_only := expect["token_only"]; token_only {
			continue
		}
		msgs := vec_arr(o, "messages")
		strs := make([]string, len(msgs), context.temp_allocator)
		for m, i in msgs {
			strs[i] = string(m.(json.String))
		}
			// These replies came from stock servers talking to stock clients that
			// announce the epoch bit, as we do. A reply with aead-epoch is taken and
			// the data keys are epoch keys. The same reply without the flag must also
			// be taken (baseline format).
		epoch := false
		for f in vec_arr(expect, "protocol_flags") {
			if string(f.(json.String)) == "aead-epoch" {
				epoch = true
			}
		}
		want_cipher := push.Cipher.Chacha20_Poly1305 if vec_str(expect, "cipher") == "CHACHA20-POLY1305" else push.Cipher.Aes_256_Gcm
		// Variant 0 is the reply as captured. Variant 1 (only with aead-epoch)
		// is the same text without that flag: the rest must still be taken.
		for variant in 0 ..< (2 if epoch else 1) {
			texts := strs
			if variant == 1 {
				texts = make([]string, len(strs), context.temp_allocator)
				for s, i in strs {
					texts[i], _ = strings.replace_all(s, " aead-epoch", "", context.temp_allocator)
				}
			}
			m := replay_push(t, texts, want_cipher, epoch && variant == 0)
			if m == nil {
				continue
			}
			defer sim_free(m)
			if epoch && variant == 0 {
				n_epoch += 1
				testing.expectf(t, session_data_format(&m.s) == .Epoch, "%s: aead-epoch not taken", name)
			} else {
				testing.expectf(t, session_data_format(&m.s) == .Baseline, "%s: not baseline", name)
			}
			n_up += 1
			if !testing.expectf(t, m.s.state == .Up, "%s: not up (%v)", name, session_fail_reason(&m.s)) {
				sim_dump(m)
				continue
			}
			po := session_pushed(&m.s)
			testing.expectf(t, (po.ping.? or_else 0) == vec_int(expect, "ping"), "%s: ping", name)
			testing.expectf(t, (po.ping_restart.? or_else 0) == vec_int(expect, "ping_restart"), "%s: ping-restart", name)
			testing.expectf(t, int(po.peer_id.? or_else 99) == vec_int(expect, "peer_id"), "%s: peer-id", name)
			testing.expectf(t, len(po.routes) == vec_int(expect, "route_count"), "%s: route count %d", name, len(po.routes))
			gw := po.route_gateway.? or_else {}
			testing.expectf(t, gw == [4]u8{10, 8, 0, 1}, "%s: route-gateway", name)
			testing.expectf(t, push.cipher_name(session_cipher(&m.s)) == vec_str(expect, "cipher"), "%s: cipher", name)
			ifc := po.ifconfig.? or_else {}
			testing.expectf(t, ifc.a == [4]u8{10, 8, 0, 2} && ifc.b == [4]u8{255, 255, 255, 0}, "%s: ifconfig", name)
			if prefix := vec_str(expect, "auth_token_prefix"); len(prefix) > 0 {
				user, token, have := session_auth_token(&m.s)
				testing.expectf(t, have && strings.has_prefix(token, prefix), "%s: token", name)
				testing.expectf(t, user == "alice", "%s: token user %q", name, user)
			}
		}
	}
	testing.expectf(t, n_up >= 2, "too few replies replayed (%d)", n_up)
	testing.expectf(t, n_epoch >= 3, "too few aead-epoch replies seen (%d)", n_epoch)
}

// Brings a session up on the fake server, but the PUSH_REPLY text comes from
// the vector instead of the fake's own builder.
replay_push :: proc(t: ^testing.T, msgs: []string, cipher: push.Cipher, epoch: bool) -> ^Sim {
	m := sim_new({mode = .Tls_Crypt, raw_reply = msgs, login = true, cipher = cipher, epoch = epoch})
	if m == nil {
		return nil
	}
	if err := sim_start(m); err != .None {
		testing.expectf(t, false, "start: %v", err)
		sim_free(m)
		return nil
	}
	sim_run(m, g_done, 30 * time.Second)
	return m
}

// The token-only reply of a renegotiated key state replaces the token.
@(test)
test_vectors_token_only_reply :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, PUSH_VECTORS)
	if !ok {
		return
	}
	text := ""
	for c in vec_arr(root, "cases") {
		o := c.(json.Object)
		if _, token_only := vec_obj(o, "expect")["token_only"]; token_only {
			text = string(vec_arr(o, "messages")[0].(json.String))
		}
	}
	if !testing.expect(t, len(text) > 0, "no token-only vector") {
		return
	}
	m := connect(t, {mode = .Tls_Crypt, dyn = true, login = true, token = true})
	if m == nil {
		return
	}
	defer sim_free(m)
	rekey_cycle(t, m, false)
	fake_text_out(&m.f, text, m.now)
	sim_settle(m)
	testing.expect(t, sim_has_event(m, .Token_Updated), "no Token_Updated")
	_, token, have := session_auth_token(&m.s)
	testing.expect(t, have, "token lost")
	testing.expect(t, strings.has_prefix(token, "SESS_ID_AT_"), "token not replaced")
	testing.expect_value(t, m.s.state, State.Up)
}

// ----------------------------------------------------------------- data channel

// Packets from stock 2.6.23 (baseline format) and 2.7.7 (epoch format): keys come
// from the TLS exporter output of the capture. What the stock server sent decrypts
// to the recorded plaintext; what our client seals is byte for byte what the stock
// client sent.
@(test)
test_vectors_data_channel :: proc(t: ^testing.T) {
	defer free_all(context.temp_allocator)
	root, ok := vec_load(t, DATA_VECTORS)
	if !ok {
		return
	}
	replayed, replayed_epoch := 0, 0
	for c in vec_arr(root, "cases") {
		o := c.(json.Object)
		format := keys.Format.Baseline
		if strings.has_prefix(vec_str(o, "format"), "epoch") {
			format = .Epoch
			replayed_epoch += 1
		}
		replayed += 1
		name := vec_str(o, "cell")
		cipher: push.Cipher
		switch vec_str(o, "cipher") {
		case "AES-256-GCM":
			cipher = .Aes_256_Gcm
		case "AES-128-GCM":
			cipher = .Aes_128_Gcm
		case "CHACHA20-POLY1305":
			cipher = .Chacha20_Poly1305
		}
		export := unhex(vec_str(vec_obj(o, "exporter"), "output_hex"))
		m := sim_new({mode = .Tls_Crypt})
		if m == nil {
			return
		}
		defer sim_free(m)
		if !testing.expectf(t, session_init(&m.s, &m.cfg) == .None, "%s: init", name) {
			continue
		}
		m.started = true
		// Put the session in the "up" state with the vector's key.
		s := &m.s
		mat, merr := keys.derive_material(export, .Client, aead_of(cipher))
		if !testing.expectf(t, merr == .None, "%s: derive", name) {
			continue
		}
		if !testing.expectf(t, crypt.data_key_init(&s.dp.dk[0], format, aead_of(cipher), 0, &mat, {}) == .None, "%s: key", name) {
			continue
		}
		s.format = format
		keys.material_wipe(&mat)
		s.dp.dk_used[0] = true
		s.dp.dk_of[0] = 0
		s.cipher = cipher
		s.peer_id = 0
		s.state = .Up
		s.ks.state = .Generated_Keys
		keys.slots_install(&s.slots, 0, time.Second)
		keys.slots_install(&s.dp.slots, 0, time.Second)
		s.dp.format = format
		for p in vec_arr(o, "packets") {
			po := p.(json.Object)
			wire_bytes := unhex(vec_str(po, "wire_hex"))
			plain := unhex(vec_str(po, "plaintext_hex"))
			kind := vec_str(po, "kind")
			if vec_str(po, "dir") == "s2c" {
				buf := make([]u8, len(wire_bytes), context.temp_allocator)
				copy(buf, wire_bytes)
				r := session_receive(s, buf, time.Second)
				if kind == "ping" {
					testing.expectf(t, len(r.tunnel) == 0 && s.counters.ping_rx == 1, "%s: ping not recognised", name)
				} else {
					testing.expectf(t, string(r.tunnel) == string(plain), "%s: s2c %s differs", name, kind)
				}
			} else if kind != "ping" {
				buf := make([]u8, 2 + 24 + len(plain) + 32, context.temp_allocator)
				copy(buf[TUNNEL_HEADROOM:], plain)
				pkt, err := session_encap(s, buf, len(plain), time.Second)
				testing.expectf(t, err == .None, "%s: encap %v", name, err)
				testing.expectf(t, string(pkt) == string(wire_bytes), "%s: c2s %s differs\n got  %x\n want %x", name, kind, pkt, wire_bytes)
			}
		}
		testing.expectf(t, s.counters.tunnel_rx >= 2, "%s: tunnel packets not delivered", name)
		testing.expectf(t, s.counters.drop_data_tag == 0 && s.counters.drop_data_epoch == 0, "%s: packets dropped", name)
	}
	testing.expect(t, replayed - replayed_epoch >= 3, "too few baseline cases")
	testing.expect(t, replayed_epoch >= 3, "too few epoch cases")
}
