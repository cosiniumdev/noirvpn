// Prints the option reference (docs/options.md) from the option table of
// proto/config. Run `make docs` after a change to the table.
package main

import "core:fmt"
import "core:os"
import "core:strings"
import "noir:proto/config"

main :: proc() {
	counts := config.option_counts()
	total := 0
	for n in counts {
		total += n
	}
	not_applied := 0
	for &o in config.option_table() {
		if config.option_not_applied(&o) {
			not_applied += 1
		}
	}
	sb := strings.builder_make()
	fmt.sbprintf(
		&sb,
		`# Option reference

<!-- Generated by build/gen-options-doc from proto/config/table.odin. Do not edit: run "make docs". -->

noirvpn reads OpenVPN configuration files. This page lists the %d options that
it knows: the options of OpenVPN 2.6 and 2.7, and the options that only noirvpn
has.

| Status | Count | What noirvpn does |
|--------|------:|-------------------|
| Supported | %d | The option works as in OpenVPN. |
| New in noirvpn | %d | The option does not exist in OpenVPN. |
| Not applied yet | %d | noirvpn reads the option but does not use it yet. The note says if it warns or refuses to start. |
| Ignored | %d | The option has no effect. noirvpn warns at start and in `+"`--check-config`"+`. |
| Rejected | %d | noirvpn does not start. The error gives the reason and, if one exists, the replacement. |

The other columns:

- **Applies to**: `+"`client`"+`, `+"`server`"+` or `+"`both`"+`.
- **Arguments**: the number of arguments. `+"`1-2`"+` is one or two, `+"`3+`"+` is three or more.
- **Pushable**: a server can push the option to its clients.

An option that is not on this page is a start-up error. It becomes a warning if
the configuration lists the option in `+"`ignore-unknown-option`"+` or sets
`+"`setenv FORWARD_COMPATIBLE 1`"+`. To see what noirvpn does with each line of a
configuration, run `+"`noirvpn --check-config --config FILE`"+`.

How to use the options: [client configuration](client.md), [server
configuration](server.md) and [the tls transport](tls-transport.md).

`,
		total,
		counts[.Supported] - not_applied,
		counts[.New],
		not_applied,
		counts[.Ignored],
		counts[.Rejected],
	)
	strings.write_string(&sb, config.option_table_markdown())
	text := strings.trim_right_space(strings.to_string(sb))
	os.write_string(os.stdout, text)
	os.write_string(os.stdout, "\n")
}
